{
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@react-motion-router/*": [
        "./packages/*/build"
      ],
      "web-animations-extension": [
        "./packages/web-animations-extension/build"
      ]
    },
    "declaration": true,
    "sourceMap": true,
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "/Users/absurdprofit/W/react-motion-router/node_modules/vitest/dist/chunks/tsconfig.tmp.tsbuildinfo",
    "types": [
      "vite/client"
    ],
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "useDefineForClassFields": true,
    "preserveConstEnums": true,
    "emitDeclarationOnly": false
  },
  "exclude": [
    "node_modules",
    "build"
  ],
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts"
  ]
}