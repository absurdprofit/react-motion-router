      "Safari >= 17.4",
      "iOS >= 17.4",
      "Firefox >= 89",
      "Edge >= 89"
    ]
  },
  "devDependencies": {
    "@types/styled-components": "^5.1.15",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.1.1",
    "postcss-nesting": "^12.0.1",
    "rollup-plugin-license": "^3.2.0"
  }
